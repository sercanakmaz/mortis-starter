{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=boilerplate;Username=postgres;Password=postgres",
    "RabbitMq": "amqp://guest:guest@localhost:5672/"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Auth": {
    "Authority": "",
    "Issuer": "boilerplate",
    "Audience": "boilerplate",
    "SubjectClaim": "sub",
    "EmailClaim": "email",
    "TenantClaim": "tenant_id",
    "LanguageClaim": "locale"
  },
  "Observability": {
    "OtlpEndpoint": "",
    "OutboxLagThresholdSeconds": 60
  },
  "Idempotency": {
    "RetentionHours": 24,
    "InProgressTimeoutSeconds": 60
  },
  "Caching": {
    "Seconds": 60
  }
