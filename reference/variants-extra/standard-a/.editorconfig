root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.{yml,yaml,json,xml,csproj,props,targets,slnx}]
indent_size = 2

[*.cs]
dotnet_diagnostic.RS0030.severity = error
csharp_style_namespace_declarations = file_scoped:warning
