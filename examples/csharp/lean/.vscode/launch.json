{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Console: run a command (asks for the name and the JSON)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-console",
      "program": "${workspaceFolder}/src/Acme.Console/bin/Debug/net10.0/Acme.Console.dll",
      "args": [
        "${input:name}",
        "${input:json}"
      ],
      "cwd": "${workspaceFolder}/src/Acme.Console",
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ],
  "inputs": [
    {
      "id": "name",
      "type": "promptString",
      "description": "A command name without its Command suffix"
    },
    {
      "id": "json",
      "type": "promptString",
      "description": "The command as JSON, or @path/to/file.json. Leave empty for a command without fields",
      "default": ""
    }
  ]
}
