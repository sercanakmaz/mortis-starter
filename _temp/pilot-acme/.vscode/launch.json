{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Console: run a command or scenario (asks for the arguments)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-console",
      "program": "${workspaceFolder}/src/Acme.Console/bin/Debug/net10.0/Acme.Console.dll",
      "args": [
        "${input:name}",
        "${input:json}"
      ],
      "cwd": "${workspaceFolder}/src/Acme.Console",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Console: CreateProduct (edit the JSON in args)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-console",
      "program": "${workspaceFolder}/src/Acme.Console/bin/Debug/net10.0/Acme.Console.dll",
      "args": [
        "CreateProduct",
        "{\"sku\":\"BOLT\",\"name\":\"Bolt\",\"stock\":10}"
      ],
      "cwd": "${workspaceFolder}/src/Acme.Console",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Console: stock-flow scenario",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-console",
      "program": "${workspaceFolder}/src/Acme.Console/bin/Debug/net10.0/Acme.Console.dll",
      "args": [
        "stock-flow"
      ],
      "cwd": "${workspaceFolder}/src/Acme.Console",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Console: order-flow scenario",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-console",
      "program": "${workspaceFolder}/src/Acme.Console/bin/Debug/net10.0/Acme.Console.dll",
      "args": [
        "order-flow"
      ],
      "cwd": "${workspaceFolder}/src/Acme.Console",
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ],
  "inputs": [
    {
      "id": "name",
      "type": "promptString",
      "description": "A command name without its Command suffix, or a scenario name"
    },
    {
      "id": "json",
      "type": "promptString",
      "description": "The command as JSON, or @path/to/file.json. Leave empty for a scenario",
      "default": ""
    }
  ]
}
